# config.env — Configuración del bridge WitMotion WT901WIFI -> Blender
# ---------------------------------------------------------------------
# Formato CLAVE=valor (estilo .env). Se lee sin dependencias externas.
# Líneas que empiezan por '#' y líneas vacías se ignoran.
# NO uses comillas en los valores; se toman tal cual hasta el fin de línea.
#
# Este es el único fichero que normalmente hay que tocar al cambiar de PC,
# de red o de escena. El script blender_udp_bridge.py lo carga al arrancar.

# --- Red / socket UDP ---
# IP en la que escucha tu Mac. 0.0.0.0 = todas las interfaces (recomendado).
LISTEN_HOST=0.0.0.0
# Puerto donde el/los sensor(es) envían los datos. Debe coincidir con el
# "user server port" configurado en el sensor desde la app/PC de WitMotion.
LISTEN_PORT=1399

# --- Mapeo sensor -> objeto de Blender ---
# Cada sensor emite su DeviceID (primer campo del CSV). Aquí asignas qué
# objeto de la escena mueve cada sensor. Formato: DeviceID:Objeto, separados
# por comas. Ejemplo multi-sensor: WT53abc:Brazo_L,WT53def:Brazo_R
# Para un solo sensor de prueba, usa el comodín '*' -> mueve DEFAULT_OBJECT.
DEVICE_MAP=*:Cube
# Objeto por defecto para DeviceIDs no listados (o para el comodín '*').
DEFAULT_OBJECT=Cube

# --- Calibración de pose de referencia ---
# Si es 1, al arrancar espera CALIB_COUNTDOWN segundos y captura la
# orientación actual de cada sensor como "cero" (pose de referencia, p.ej.
# T-pose). Después, a cada lectura se le aplica el offset inverso.
AUTO_CALIBRATE=1
CALIB_COUNTDOWN=3

# --- Mapeo de ejes (según cómo esté montado físicamente el sensor) ---
# El sensor da ángulos en su propio marco; Blender es Z-up. Ajusta los
# signos si algún eje gira "al revés" respecto al objeto. Verifícalo en real.
SIGN_ROLL=1
SIGN_PITCH=1
SIGN_YAW=1

# --- Protocolo / parsing (índices de campo del CSV del WT901WIFI) ---
# El formato exacto puede variar con el firmware. VERIFICA primero con
# tools/read_udp.py y ajusta estos índices si hiciera falta.
# Campos por defecto (separados por comas), índice basado en 0:
#   0=DeviceID  1..3=Acc  4..6=Gyro  7..9=Angle(X,Y,Z)  10..12=Mag  ...
IDX_DEVICE=0
IDX_ANGLE_X=7
IDX_ANGLE_Y=8
IDX_ANGLE_Z=9
# Nº mínimo de campos para considerar la trama válida.
MIN_FIELDS=10
