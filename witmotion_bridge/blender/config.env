# config.env — WitMotion WT901WIFI -> Blender bridge configuration
# ---------------------------------------------------------------------
# KEY=value format (.env style). Read without external dependencies.
# Lines starting with '#' and empty lines are ignored.
# Do NOT use quotes in values; they are taken verbatim to end of line.
#
# This is the only file you normally need to touch when changing PC,
# network or scene. blender_udp_bridge.py loads it at startup.

# --- Network / UDP socket ---
# IP your Mac listens on. 0.0.0.0 = all interfaces (recommended).
LISTEN_HOST=0.0.0.0
# Port the sensor(s) send data to. Must match the "user server port"
# configured on the sensor from the WitMotion app/PC tool.
LISTEN_PORT=1399

# --- Sensor -> Blender object mapping ---
# Each sensor emits its DeviceID (first CSV field). Here you assign which
# scene object each sensor moves. Format: DeviceID:Object, comma-separated.
# Multi-sensor example: WT53abc:Arm_L,WT53def:Arm_R
# For a single test sensor, use the '*' wildcard -> moves DEFAULT_OBJECT.
DEVICE_MAP=*:Cube
# Default object for DeviceIDs not listed (or for the '*' wildcard).
DEFAULT_OBJECT=Cube

# --- Reference pose calibration ---
# If 1, at startup it waits CALIB_COUNTDOWN seconds and captures each
# sensor's current orientation as "zero" (reference pose, e.g. T-pose).
# Afterwards, the inverse offset is applied to every reading.
AUTO_CALIBRATE=1
CALIB_COUNTDOWN=3

# --- Axis mapping (depends on how the sensor is physically mounted) ---
# The sensor gives angles in its own frame; Blender is Z-up. Adjust the
# signs if some axis rotates "backwards" relative to the object. Verify live.
SIGN_ROLL=1
SIGN_PITCH=1
SIGN_YAW=1

# --- Protocol / parsing (WT901WIFI CSV field indices) ---
# The exact format may vary with the firmware. VERIFY first with
# tools/read_udp.py and adjust these indices if needed.
# Default fields (comma-separated), 0-based index:
#   0=DeviceID  1..3=Acc  4..6=Gyro  7..9=Angle(X,Y,Z)  10..12=Mag  ...
IDX_DEVICE=0
IDX_ANGLE_X=7
IDX_ANGLE_Y=8
IDX_ANGLE_Z=9
# Minimum number of fields for the frame to be considered valid.
MIN_FIELDS=10
