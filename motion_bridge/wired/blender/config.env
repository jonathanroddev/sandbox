# config.env — Arduino -> Blender bridge configuration
# ---------------------------------------------------------
# KEY=value format (.env style). Read without external dependencies.
# Lines starting with '#' and empty lines are ignored.
# Do NOT use quotes in values; they are taken verbatim to end of line.
#
# This is the only file you normally need to touch when changing PC or
# scene. blender_serial_bridge.py loads it at startup.

# --- Serial port ---
# The board is an Arduino Nano, which reaches the PC through a USB-serial
# chip: the port is NOT a "usbmodem" name (that belongs to boards with
# native USB).
# macOS:   ls /dev/cu.*        (/dev/cu.wchusbserial* for CH340 clones,
#                               /dev/cu.usbserial-*   for FTDI ones)
# Linux:   ls /dev/ttyUSB*     (e.g. /dev/ttyUSB0)
# Windows: Device Manager      (e.g. COM3)
#
# The value below is a placeholder: the Nano has never been plugged into
# this machine, so its real name is unknown. Run the command above and
# replace it — the bridge logs "ERROR opening serial port" until you do.
SERIAL_PORT=/dev/cu.wchusbserial-CHANGE_ME
BAUD_RATE=115200

# --- Blender scene ---
# EXACT name of the scene object that will be moved.
OBJECT_NAME=Cube

# --- Filter / tuning ---
# Gyro weight in roll/pitch (0..1). Higher = smoother but slower to correct;
# lower = more reactive to the accelerometer (more jittery).
ALPHA_ROLL_PITCH=0.98
# Samples at rest to estimate the gyro bias at startup.
GYRO_CALIB_SAMPLES=50

# --- Messages / log ---
# print() inside Blender goes to the system console, which you only see if
# you launched Blender from a terminal (Windows: Window -> Toggle System
# Console). With 1, every message is ALSO written to a Text datablock you
# can open in Blender's Text Editor — or call show_log() from the Python
# console to point an open Text Editor at it.
LOG_TO_TEXT=1
LOG_TEXT_NAME=wired_bridge_log
# The log keeps only the last N lines, so a long session cannot grow it
# without bound.
LOG_MAX_LINES=500

# --- Axis mapping (depends on how the sensor is mounted) ---
# Two levels, applied in this order:
#
# 1) SIGN_*: inverts the DIRECTION of a source. Use it when an axis rotates
#    "backwards" (the object pitches down when the sensor goes up).
SIGN_ROLL=1
SIGN_PITCH=1
SIGN_YAW=1
#
# 2) AXIS_MAP: PERMUTES which source (roll/pitch/yaw) goes to each Blender
#    axis, in X,Y,Z order. This fixes the "I move one axis and ANOTHER one
#    responds" symptom, which signs CANNOT fix (a sign inverts, it does not
#    swap). Each token is roll/pitch/yaw, with an optional '-' prefix to
#    invert.
#
#      Identity (classic):    AXIS_MAP=roll,pitch,yaw   # X=roll Y=pitch Z=yaw
#      Swap roll/pitch:       AXIS_MAP=pitch,roll,yaw
#      Invert yaw only:       AXIS_MAP=roll,pitch,-yaw
#
# EXAMPLE VALUE (an educated guess, NO hardware to validate it):
#   Left as "pitch,roll,yaw". Rationale: the sensor's "roll" is defined
#   about its X axis, but in Blender the longitudinal ("nose") axis is
#   usually +Y, so banking (roll) should drive the Y rotation and pitching
#   (pitch) the X rotation -> roll and pitch swapped. This is the most
#   likely cause of cross-axis coupling. VERIFY it with the table:
#
#     You physically rotate...    should move the axis...   check which it moves
#     roll  (about sensor X)      -> Blender X
#     pitch (about sensor Y)      -> Blender Y
#     yaw   (vertical)            -> Blender Z
#
#   If a rotation shows up on another axis, place that source in the
#   matching X/Y/Z slot. If it shows up inverted, add the '-' prefix.
#   If your mounting turns out to be aligned, go back to AXIS_MAP=roll,pitch,yaw.
AXIS_MAP=pitch,roll,yaw
