# config.env — WiFi (UDP) -> Blender bridge configuration
# ---------------------------------------------------------------------
# KEY=value format (.env style). Read without external dependencies.
# Lines starting with '#' and empty lines are ignored.
# Do NOT use quotes in values; they are taken verbatim to end of line.
#
# This is the only file you normally need to touch when changing PC,
# network or scene. blender_udp_bridge.py loads it at startup.
#
# Serves every WiFi sensor: WitMotion WT901WIFI (13-field `fused` frames)
# and Arduino/ESP + MPU-6050 (7-field `raw6` frames). See
# ../../docs/PROTOCOL.md.

# --- Network / UDP socket ---
# IP this machine listens on. 0.0.0.0 = all interfaces (recommended).
LISTEN_HOST=0.0.0.0
# Port the sensor(s) send data to. It must match what is configured on
# EVERY sensor: the "user server port" in WitMotion's tool, and DEST_PORT
# in each board's firmware/*/secrets.h.
LISTEN_PORT=1399

# --- Sensor -> Blender object mapping ---
# Each sensor emits its DeviceID (first CSV field). Here you assign which
# scene object each sensor moves. Format: DeviceID:Object, comma-separated.
# Multi-sensor example: WT53abc:Arm_L,ESP32_A:Arm_R
# For a single test sensor, use the '*' wildcard -> moves DEFAULT_OBJECT.
# Discover the real DeviceIDs with list_devices() in Blender.
DEVICE_MAP=*:Cube
# Default object for DeviceIDs not listed (or for the '*' wildcard).
DEFAULT_OBJECT=_UNASSIGNED

# --- Reference pose calibration ---
# If 1, at startup it waits CALIB_COUNTDOWN seconds and captures each
# sensor's current orientation as "zero" (reference pose, e.g. T-pose).
# Afterwards, the inverse offset is applied to every reading.
AUTO_CALIBRATE=1
# With raw6 sensors, give it room: they first spend GYRO_CALIB_SAMPLES
# frames estimating their gyro bias (50 frames at 20 Hz = 2.5 s) and only
# then produce a pose to calibrate against. 6 is a safe value for those.
CALIB_COUNTDOWN=3

# --- Axis mapping (depends on how the sensor is physically mounted) ---
# Two levels, applied in this order:
#
# 1) SIGN_*: inverts the DIRECTION of a source. Use it when an axis rotates
#    "backwards" (the object pitches down when the sensor goes up).
SIGN_ROLL=1
SIGN_PITCH=1
SIGN_YAW=1
#
# 2) AXIS_MAP: PERMUTES which source (roll/pitch/yaw) drives each Blender
#    axis, in X,Y,Z order. This fixes the "I move one axis and ANOTHER one
#    responds" symptom, which signs CANNOT fix. Each token is
#    roll/pitch/yaw, with an optional '-' prefix to invert.
#
#      Identity:          AXIS_MAP=roll,pitch,yaw   # X=roll Y=pitch Z=yaw
#      Swap roll/pitch:   AXIS_MAP=pitch,roll,yaw
#      Invert yaw only:   AXIS_MAP=roll,pitch,-yaw
#
#    Procedure (bridge running, one axis at a time):
#      you rotate roll  (about sensor X) -> Blender X should move
#      you rotate pitch (about sensor Y) -> Blender Y should move
#      you rotate yaw   (vertical)       -> Blender Z should move
#    If a rotation lands on another axis, put that source in the matching
#    X/Y/Z slot. If it lands inverted, add the '-' prefix.
#
# Left at identity: the mounting of the WiFi sensors is not decided yet.
# (The wired bridge ships pitch,roll,yaw for its own specific mounting —
# do NOT copy that value here without verifying it.)
AXIS_MAP=roll,pitch,yaw

# --- Frame profile ---
# auto  -> decide per frame from its field count (prefers `fused`)
# fused -> force "the sensor already gives me angles" (WT901WIFI)
# raw6  -> force "the sensor gives me accel+gyro, fuse it here" (Arduino/ESP)
# Leave it on auto unless a sensor sends long frames whose angles you do
# NOT want to trust.
FRAME_FORMAT=auto

# --- Protocol / parsing (CSV field indices, 0-based) ---
# The exact layout may vary with the firmware. VERIFY first with
# tools/read_udp.py and adjust these indices — never the parser code.
#   raw6  (7 fields):  0=DeviceID 1..3=Acc 4..6=Gyro
#   fused (13 fields): 0=DeviceID 1..3=Acc 4..6=Gyro 7..9=Angle 10..12=Mag
IDX_DEVICE=0
IDX_ACC_X=1
IDX_ACC_Y=2
IDX_ACC_Z=3
IDX_GYRO_X=4
IDX_GYRO_Y=5
IDX_GYRO_Z=6
IDX_ANGLE_X=7
IDX_ANGLE_Y=8
IDX_ANGLE_Z=9
# Minimum number of fields for a frame to be considered at all (junk
# filter). The per-profile requirement is derived from the indices above.
MIN_FIELDS=7

# --- Messages / log ---
# print() inside Blender goes to the system console, which you only see if
# you launched Blender from a terminal (Windows: Window -> Toggle System
# Console). With 1, every message is ALSO written to a Text datablock you
# can open in Blender's Text Editor — or call show_log() from the Python
# console to point an open Text Editor at it.
LOG_TO_TEXT=1
LOG_TEXT_NAME=wifi_bridge_log
# The log keeps only the last N lines, so a long session cannot grow it
# without bound.
LOG_MAX_LINES=500

# --- Fusion, for raw6 sensors only (ignored by fused ones) ---
# Gyro weight in roll/pitch (0..1). Higher = smoother but slower to
# correct; lower = more reactive to the accelerometer (more jittery).
ALPHA_ROLL_PITCH=0.98
# Frames at rest used to estimate each device's gyro bias at startup.
GYRO_CALIB_SAMPLES=50
