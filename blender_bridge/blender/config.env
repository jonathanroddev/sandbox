# config.env — Configuración del bridge Arduino -> Blender
# ---------------------------------------------------------
# Formato CLAVE=valor (estilo .env). Se lee sin dependencias externas.
# Líneas que empiezan por '#' y líneas vacías se ignoran.
# NO uses comillas en los valores; se toman tal cual hasta el fin de línea.
#
# Este es el único fichero que normalmente hay que tocar al cambiar de PC
# o de escena. El script blender_serial_bridge.py lo carga al arrancar.

# --- Puerto serial ---
# En macOS:   ls /dev/cu.*        (p.ej. /dev/cu.usbmodem11201)
# En Linux:   ls /dev/ttyUSB* /dev/ttyACM*   (p.ej. /dev/ttyACM0)
# En Windows: Administrador de dispositivos   (p.ej. COM3)
SERIAL_PORT=/dev/cu.usbmodem11201
BAUD_RATE=115200

# --- Escena de Blender ---
# Nombre EXACTO del objeto de la escena que se moverá.
OBJECT_NAME=Cube

# --- Filtro / tuning ---
# Peso del giroscopio en roll/pitch (0..1). Más alto = más suave pero más
# lento a corregir; más bajo = más reactivo al acelerómetro (más nervioso).
ALPHA_ROLL_PITCH=0.98
# Muestras en reposo para estimar el bias del giroscopio al arrancar.
GYRO_CALIB_SAMPLES=50

# --- Mapeo de ejes (según cómo esté montado el sensor) ---
# Cambia a -1 el que gire "al revés" respecto al objeto en Blender.
SIGN_ROLL=1
SIGN_PITCH=1
SIGN_YAW=1
