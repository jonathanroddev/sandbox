# config.env — Configuración del bridge Arduino -> Blender
# ---------------------------------------------------------
# Formato CLAVE=valor (estilo .env). Se lee sin dependencias externas.
# Líneas que empiezan por '#' y líneas vacías se ignoran.
# NO uses comillas en los valores; se toman tal cual hasta el fin de línea.
#
# Este es el único fichero que normalmente hay que tocar al cambiar de PC
# o de escena. El script blender_serial_bridge.py lo carga al arrancar.

# --- Puerto serial ---
# En macOS:   ls /dev/cu.*        (p.ej. /dev/cu.usbmodem11201)
# En Linux:   ls /dev/ttyUSB* /dev/ttyACM*   (p.ej. /dev/ttyACM0)
# En Windows: Administrador de dispositivos   (p.ej. COM3)
SERIAL_PORT=/dev/cu.usbmodem11201
BAUD_RATE=115200

# --- Escena de Blender ---
# Nombre EXACTO del objeto de la escena que se moverá.
OBJECT_NAME=Cube

# --- Filtro / tuning ---
# Peso del giroscopio en roll/pitch (0..1). Más alto = más suave pero más
# lento a corregir; más bajo = más reactivo al acelerómetro (más nervioso).
ALPHA_ROLL_PITCH=0.98
# Muestras en reposo para estimar el bias del giroscopio al arrancar.
GYRO_CALIB_SAMPLES=50

# --- Mapeo de ejes (según cómo esté montado el sensor) ---
# Dos niveles, se aplican en este orden:
#
# 1) SIGN_*: invierte el SENTIDO de una fuente. Úsalo cuando un eje gira
#    "al revés" (el objeto cabecea hacia abajo cuando el sensor sube).
SIGN_ROLL=1
SIGN_PITCH=1
SIGN_YAW=1
#
# 2) AXIS_MAP: PERMUTA qué fuente (roll/pitch/yaw) va a cada eje de Blender,
#    en orden X,Y,Z. Esto arregla el síntoma "muevo un eje y responde OTRO",
#    que los signos NO pueden corregir (un signo invierte, no intercambia).
#    Cada token es roll/pitch/yaw, con prefijo '-' opcional para invertir.
#
#      Identidad (clásico):   AXIS_MAP=roll,pitch,yaw   # X=roll Y=pitch Z=yaw
#      Intercambiar roll/pitch: AXIS_MAP=pitch,roll,yaw
#      Invertir solo el yaw:    AXIS_MAP=roll,pitch,-yaw
#
# VALOR DE EJEMPLO (intuición, SIN hardware para validar):
#   Se deja "pitch,roll,yaw". Razón: el "roll" del sensor se define sobre
#   su eje X, pero en Blender el eje longitudinal ("morro") suele ser +Y,
#   así que el balanceo (roll) debería mover la rotación en Y y el cabeceo
#   (pitch) la rotación en X -> roll y pitch intercambiados. Es la causa
#   más probable de tu acoplamiento cruzado. VERIFÍCALO con la tabla:
#
#     Giras físicamente...        debería mover el eje...   comprueba cuál mueve
#     roll  (sobre X del sensor)  -> X de Blender
#     pitch (sobre Y del sensor)  -> Y de Blender
#     yaw   (vertical)            -> Z de Blender
#
#   Si un giro aparece en otro eje, coloca esa fuente en la posición X/Y/Z
#   correspondiente. Si aparece invertido, añádele el prefijo '-'.
#   Si tu montaje resulta estar alineado, vuelve a AXIS_MAP=roll,pitch,yaw.
AXIS_MAP=pitch,roll,yaw
